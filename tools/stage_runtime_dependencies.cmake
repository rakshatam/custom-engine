if(NOT DEFINED OUTPUT_DIR OR NOT DEFINED ASSIMP_RUNTIME_DIR OR NOT DEFINED ASSIMP_RUNTIME_DLLS)
    message(FATAL_ERROR "OUTPUT_DIR, ASSIMP_RUNTIME_DIR, and ASSIMP_RUNTIME_DLLS must be supplied")
endif()

if(NOT IS_DIRECTORY "${ASSIMP_RUNTIME_DIR}")
    message(FATAL_ERROR "Assimp runtime directory does not exist: ${ASSIMP_RUNTIME_DIR}")
endif()

set(_staged_count 0)
foreach(_dependency_name IN LISTS ASSIMP_RUNTIME_DLLS)
    set(_dependency_path "${ASSIMP_RUNTIME_DIR}/${_dependency_name}")
    if(NOT EXISTS "${_dependency_path}")
        message(FATAL_ERROR "Required runtime DLL was not found: ${_dependency_path}")
    endif()
    configure_file("${_dependency_path}" "${OUTPUT_DIR}/${_dependency_name}" COPYONLY)
    math(EXPR _staged_count "${_staged_count} + 1")
endforeach()

message(STATUS "Staged ${_staged_count} non-system runtime dependencies")

if(DEFINED JOLT_BRIDGE AND DEFINED JOLT_RUNTIME_DIR)
    if(NOT EXISTS "${JOLT_BRIDGE}" OR NOT IS_DIRECTORY "${JOLT_RUNTIME_DIR}")
        message(FATAL_ERROR "Jolt bridge/runtime files are unavailable for staging")
    endif()
    configure_file("${JOLT_BRIDGE}" "${OUTPUT_DIR}/JoltBridge.dll" COPYONLY)
    configure_file("${JOLT_RUNTIME_DIR}/libJolt.dll" "${OUTPUT_DIR}/libJolt.dll" COPYONLY)
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/jolt_runtime")
    foreach(_jolt_runtime IN ITEMS libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll)
        if(NOT EXISTS "${JOLT_RUNTIME_DIR}/${_jolt_runtime}")
            message(FATAL_ERROR "Jolt runtime DLL was not found: ${JOLT_RUNTIME_DIR}/${_jolt_runtime}")
        endif()
        configure_file("${JOLT_RUNTIME_DIR}/${_jolt_runtime}" "${OUTPUT_DIR}/jolt_runtime/${_jolt_runtime}" COPYONLY)
    endforeach()
    message(STATUS "Staged the Jolt C ABI bridge, Jolt DLL, and isolated UCRT64 runtime folder")
endif()
